# SuperTuner environment configuration.
# Copy to .env and adjust; every value below has a working default.
# Paths are resolved from these variables only — nothing is hardcoded.

# --- storage -----------------------------------------------------------------
# Root for runs, checkpoints and the SQLite registry. Defaults to ~/.supertuner.
# SUPERTUNER_HOME=~/.supertuner
# Model weights (H3, Wan, Qwen). Relative values resolve against SUPERTUNER_HOME.
# SUPERTUNER_MODELS_DIR=models
# Datasets (video clips, jsonl instruction files).
# SUPERTUNER_DATASETS_DIR=datasets
# Latent/text embedding caches.
# SUPERTUNER_CACHE_DIR=cache

# --- server ------------------------------------------------------------------
SUPERTUNER_HOST=127.0.0.1
SUPERTUNER_PORT=8787
# Command used to start the Python engine. Default: uv run --project engine supertuner-engine
# SUPERTUNER_ENGINE_CMD=uv run --project engine supertuner-engine
# Built UI to serve as static files (packages/web/dist).
# SUPERTUNER_WEB_DIST=
SUPERTUNER_MAX_CONCURRENT_RUNS=1
# Allow dataset/output paths outside the configured roots. Off by default.
SUPERTUNER_ALLOW_ANY_PATH=0

# --- engine ------------------------------------------------------------------
# Optional path to a musubi-tuner checkout used by the video backend.
# SUPERTUNER_MUSUBI_PATH=
SUPERTUNER_ENGINE_LOG_LEVEL=info
# Enable GPU-tagged pytest runs.
# SUPERTUNER_RUN_GPU_TESTS=1

# --- web ---------------------------------------------------------------------
# Leave empty to use the same origin as the UI (Vite proxies /api in dev).
VITE_API_BASE=
